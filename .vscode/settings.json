{
  "latex-workshop.latex.outDir": "%DIR%/output/pdf",
  "latex-workshop.latex.jobname": "memorial_portico_rolante",
  "latex-workshop.latex.autoBuild.run": "onFileChange",
  "latex-workshop.latex.tools": [
    {
      "name": "latexmk",
      "command": "latexmk",
      "args": [
        "-pdf",
        "-interaction=nonstopmode",
        "-synctex=1",
        "-file-line-error",
        "%DOC%"
      ]
    }
  ],
  "latex-workshop.latex.recipes": [
    {
      "name": "latexmk (output)",
      "tools": [
        "latexmk"
      ]
    }
  ],
  "latex-workshop.latex.recipe.default": "lastUsed",
  "[latex]": {
    "editor.defaultFormatter": "James-Yu.latex-workshop",
    "editor.formatOnSave": true,
    "editor.tabSize": 2,
    "editor.insertSpaces": true,
    "editor.detectIndentation": false,
    "editor.wordWrap": "wordWrapColumn",
    "editor.wordWrapColumn": 100,
    "editor.rulers": [
      100
    ],
    "editor.wrappingIndent": "same"
  },
  "latex-workshop.formatting.latex": "latexindent",
  "latex-workshop.formatting.latexindent.path": "latexindent",
  "latex-workshop.formatting.latexindent.args": [
    "%TMPFILE%",
    "-l=%DIR%/.latexindent.yaml"
  ],
  "ltex.enabled": true,
  "ltex.language": "pt-BR",
  "ltex.diagnosticSeverity": "warning",
  "ltex.disabledRules": {
    "pt-BR": []
  },
  "ltex.hiddenFalsePositives": {
    "pt-BR": [
      "{\"rule\":\"MORFOLOGIK_RULE_PT_BR\",\"sentence\":\".*Dummy.*\"}",
      "{\"rule\":\"MORFOLOGIK_RULE_PT_BR\",\"sentence\":\".*Ina.*\"}",
      "{\"rule\":\"PARONYM_POLIA_522\",\"sentence\":\".*polia.*\"}",
      "{\"rule\":\"PT_BARBARISMS_REPLACE_SUITE\",\"sentence\":\".*Suite.*\"}",
      "{\"rule\":\"UPPERCASE_SENTENCE_START\",\"sentence\":\".*\\\\{memorial\\\\}.*\"}"
    ]
  },
  "ltex.dictionary": {
    "pt-BR": [
      "LaTeX",
      "MiKTeX",
      "latexmk",
      "latexindent",
      "pórtico rolante",
      "LTeX",
      "PDFs",
      "Strawberry",
      "moitão",
      "CIMAF",
      "Warrington",
      "Seale",
      "CMAA",
      "EMH",
      "Specification",
      "Suite",
      "NC",
      "Solferina",
      "GOSAN",
      "Gosan",
      "ASTM",
      "SCHEDULE",
      "SEW",
      "EURODRIVE",
      "Motoredutores",
      "Gaiolli",
      "SKF",
      "WEG",
      "Annestraße",
      "BOHMER",
      "DIN",
      "CESTARI",
      "Macaulay"
    ]
  },
  "ltex.latex.commands": {
    "\\si{}": "dummy",
    "\\SI{}{}": "dummy",
    "\\titleformat{}[]": "dummy",
    "\\boxed{}": "dummy",
    "\\fancypagestyle{}": "dummy",
    "\\assignpagestyle{}{}": "dummy"
  },
  "ltex.latex.environments": {
    "equation": "ignore",
    "math": "ignore"
  }
}
