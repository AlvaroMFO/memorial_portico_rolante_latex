{
  "latex-workshop.latex.outDir": "%DIR%/output/pdf",
  "latex-workshop.latex.autoBuild.run": "onFileChange",
  "latex-workshop.latex.tools": [
    {
      "name": "latexmk",
      "command": "latexmk",
      "args": [
        "-pdf",
        "-interaction=nonstopmode",
        "-synctex=1",
        "-file-line-error",
        "%DOC%"
      ]
    }
  ],
  "latex-workshop.latex.recipes": [
    {
      "name": "latexmk (output)",
      "tools": [
        "latexmk"
      ]
    }
  ],
  "latex-workshop.latex.recipe.default": "lastUsed",
  "[latex]": {
    "editor.defaultFormatter": "James-Yu.latex-workshop",
    "editor.formatOnSave": true,
    "editor.tabSize": 2,
    "editor.insertSpaces": true,
    "editor.detectIndentation": false,
    "editor.wordWrap": "wordWrapColumn",
    "editor.wordWrapColumn": 100,
    "editor.rulers": [
      100
    ],
    "editor.wrappingIndent": "same"
  },
  "latex-workshop.formatting.latex": "latexindent",
  "latex-workshop.formatting.latexindent.path": "C:/Strawberry/perl/bin/perl.exe",
  "latex-workshop.formatting.latexindent.args": [
    "C:/Users/Alvaro.ALVARO-OLIVEIRA/AppData/Local/Programs/MiKTeX/scripts/latexindent/latexindent.pl",
    "%TMPFILE%",
    "-l=%DIR%/.latexindent.yaml"
  ],
  "ltex.enabled": true,
  "ltex.language": "pt-BR",
  "ltex.diagnosticSeverity": "information",
  "ltex.enabledRules": {
    "pt-BR": []
  },
  "ltex.disabledRules": {
    "pt-BR": []
  },
  "ltex.dictionary": {
    "pt-BR": [
      "LaTeX",
      "MiKTeX",
      "latexmk",
      "latexindent",
      "pórtico rolante",
      "LTeX",
      "PDFs",
      "Strawberry",
      "moitão"
    ]
  }
}
